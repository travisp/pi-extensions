{
  "name": "pi-remote-ssh-admin",
  "version": "0.2.0",
  "description": "Pi extension that routes remote tools through persistent SSH shell transports, with optional approved sudo elevation.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ssh",
    "remote-admin"
  ],
  "homepage": "https://github.com/travisp/pi-remote-ssh-admin#readme",
  "bugs": {
    "url": "https://github.com/travisp/pi-remote-ssh-admin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/travisp/pi-remote-ssh-admin.git"
  },
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke:fake-ssh": "node scripts/smoke-fake-ssh.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/remote-admin.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*"
  }
}
