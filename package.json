{
  "name": "travis-pi-extensions",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/prompt-ninja/src/pi-prompt-ninja.ts",
      "./extensions/remote-ssh-admin/extensions/remote-admin.ts",
      "./extensions/auto-session-name/index.ts",
      "./extensions/slash-command-guard/index.ts",
      "./extensions/system-prompt-display/index.ts",
      "./extensions/herdr-dev/src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs extensions/herdr-dev/test/*.test.mjs && cd extensions/remote-ssh-admin && node scripts/smoke-fake-ssh.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
